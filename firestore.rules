rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStorySummaryId(id) {
      return id is string && id.size() >= 6 && id.size() <= 10 && id.matches('^([1-9]|[12][0-9]|30)_(easy|normal|hard)$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidHexOrEmpty(val) {
      return val is string && val.size() <= 7 && (val == '' || val.matches('^#[0-9a-fA-F]{6}$'));
    }

    function isValidBiome(b) {
      return b is string && b.size() <= 12 && b in ['grass', 'sand', 'city', 'ice', 'lava', 'moon'];
    }

    function isValidDifficulty(d) {
      return d is string && d.size() <= 10 && d in ['easy', 'normal', 'hard'];
    }

    function isValidObjectiveMode(m) {
      return m is string && m.size() <= 16 && m in ['eradication', 'survival', 'target_kills'];
    }

    function isValidCommunityLevel(data) {
      return data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 40
        && data.description is string
        && data.description.size() <= 140
        && data.authorId is string
        && data.authorId.size() >= 1
        && data.authorId.size() <= 128
        && data.authorId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 24
        && isValidBiome(data.biome)
        && isValidHexOrEmpty(data.customWallColor)
        && isValidHexOrEmpty(data.customFloorColor)
        && isValidDifficulty(data.difficulty)
        && (!('objectiveMode' in data) || isValidObjectiveMode(data.objectiveMode))
        && (!('targetDurationSec' in data) || (data.targetDurationSec is int && data.targetDurationSec >= 60 && data.targetDurationSec <= 600))
        && (!('targetKills' in data) || (data.targetKills is int && data.targetKills >= 10 && data.targetKills <= 500))
        && data.criticalLimit is int
        && data.criticalLimit >= 30
        && data.criticalLimit <= 250
        && data.ratSpeed is number
        && data.ratSpeed >= 1.5
        && data.ratSpeed <= 4.5
        && data.breedCooldown is number
        && data.breedCooldown >= 2.5
        && data.breedCooldown <= 8.0
        && data.layout is list
        && data.layout.size() >= 9
        && data.layout.size() <= 100
        && data.layout[0] is string
        && data.layout[0].size() >= 11
        && data.layout[0].size() <= 100
        && data.layout[data.layout.size() - 1] is string
        && data.layout[data.layout.size() - 1].size() >= 11
        && data.layout[data.layout.size() - 1].size() <= 100
        && data.tunnels is list
        && data.tunnels.size() <= 4
        && (data.tunnels.size() == 0 || data.tunnels[0] is map)
        && data.initialRats is list
        && data.initialRats.size() >= 2
        && data.initialRats.size() <= 50
        && data.initialRats[0] is map
        && data.isPublished is bool
        && data.bestTimeMs is int
        && data.bestTimeMs >= 0
        && data.bestTimeMs <= 36000000
        && (!('bestScore' in data) || (data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 1000000))
        && (!('bestEliminatedCount' in data) || (data.bestEliminatedCount is int && data.bestEliminatedCount >= 0 && data.bestEliminatedCount <= 10000))
        && (!('bestBabiesEliminatedCount' in data) || (data.bestBabiesEliminatedCount is int && data.bestBabiesEliminatedCount >= 0 && data.bestBabiesEliminatedCount <= 10000))
        && data.bestPlayerName is string
        && data.bestPlayerName.size() <= 24
        && data.playCount is int
        && data.playCount >= 0
        && data.playCount <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasExactLevelKeys(data) {
      let allowed = [
        'title',
        'description',
        'authorId',
        'authorName',
        'biome',
        'customWallColor',
        'customFloorColor',
        'difficulty',
        'objectiveMode',
        'targetDurationSec',
        'targetKills',
        'criticalLimit',
        'ratSpeed',
        'breedCooldown',
        'layout',
        'tunnels',
        'initialRats',
        'isPublished',
        'bestTimeMs',
        'bestScore',
        'bestEliminatedCount',
        'bestBabiesEliminatedCount',
        'bestPlayerName',
        'playCount',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(allowed) && data.keys().hasOnly(allowed);
    }

    function isValidLevelRun(data) {
      return data.levelId is string
        && data.levelId.size() >= 1
        && data.levelId.size() <= 128
        && data.levelId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.runnerId is string
        && data.runnerId == request.auth.uid
        && data.runnerId.size() <= 128
        && data.runnerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.playerName is string
        && data.playerName.size() >= 1
        && data.playerName.size() <= 24
        && data.timeMs is int
        && data.timeMs >= 1000
        && data.timeMs <= 36000000
        && (!('score' in data) || (data.score is int && data.score >= 0 && data.score <= 1000000))
        && data.eliminatedCount is int
        && data.eliminatedCount >= 0
        && data.eliminatedCount <= 10000
        && (!('babiesEliminatedCount' in data) || (data.babiesEliminatedCount is int && data.babiesEliminatedCount >= 0 && data.babiesEliminatedCount <= 10000))
        && data.bornCount is int
        && data.bornCount >= 0
        && data.bornCount <= 10000
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasExactRunKeys(data) {
      let allowed = [
        'levelId',
        'runnerId',
        'playerName',
        'timeMs',
        'score',
        'eliminatedCount',
        'babiesEliminatedCount',
        'bornCount',
        'isPublic',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(allowed) && data.keys().hasOnly(allowed);
    }

    function isValidStorySummary(data) {
      return data.levelId is int
        && data.levelId >= 1
        && data.levelId <= 30
        && isValidDifficulty(data.difficulty)
        && data.isPublic is bool
        && data.isPublic == true
        && data.bestTimeMs is int
        && data.bestTimeMs >= 1000
        && data.bestTimeMs <= 36000000
        && data.bestScore is int
        && data.bestScore >= 0
        && data.bestScore <= 1000000
        && data.bestEliminatedCount is int
        && data.bestEliminatedCount >= 0
        && data.bestEliminatedCount <= 10000
        && data.bestBabiesEliminatedCount is int
        && data.bestBabiesEliminatedCount >= 0
        && data.bestBabiesEliminatedCount <= 10000
        && data.bestPlayerName is string
        && data.bestPlayerName.size() >= 1
        && data.bestPlayerName.size() <= 24
        && data.playCount is int
        && data.playCount >= 1
        && data.playCount <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasExactStorySummaryKeys(data) {
      let allowed = [
        'levelId',
        'difficulty',
        'isPublic',
        'bestTimeMs',
        'bestScore',
        'bestEliminatedCount',
        'bestBabiesEliminatedCount',
        'bestPlayerName',
        'playCount',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(allowed) && data.keys().hasOnly(allowed);
    }

    function isValidStoryRun(data) {
      return data.levelId is int
        && data.levelId >= 1
        && data.levelId <= 30
        && data.runnerId is string
        && data.runnerId == request.auth.uid
        && data.runnerId.size() <= 128
        && data.runnerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.playerName is string
        && data.playerName.size() >= 1
        && data.playerName.size() <= 24
        && isValidDifficulty(data.difficulty)
        && isValidObjectiveMode(data.objectiveMode)
        && data.timeMs is int
        && data.timeMs >= 1000
        && data.timeMs <= 36000000
        && data.score is int
        && data.score >= 0
        && data.score <= 1000000
        && data.eliminatedCount is int
        && data.eliminatedCount >= 0
        && data.eliminatedCount <= 10000
        && data.babiesEliminatedCount is int
        && data.babiesEliminatedCount >= 0
        && data.babiesEliminatedCount <= 10000
        && data.bornCount is int
        && data.bornCount >= 0
        && data.bornCount <= 10000
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasExactStoryRunKeys(data) {
      let allowed = [
        'levelId',
        'runnerId',
        'playerName',
        'difficulty',
        'objectiveMode',
        'timeMs',
        'score',
        'eliminatedCount',
        'babiesEliminatedCount',
        'bornCount',
        'isPublic',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(allowed) && data.keys().hasOnly(allowed);
    }

    match /community_levels/{levelId} {
      allow get: if isValidId(levelId)
        && (resource == null || existing().isPublished == true || (isSignedIn() && existing().authorId == request.auth.uid));

      allow list: if existing().isPublished == true
        || (isSignedIn() && existing().authorId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(levelId)
        && isValidCommunityLevel(incoming())
        && hasExactLevelKeys(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().bestTimeMs == 0
        && incoming().bestScore == 0
        && incoming().bestEliminatedCount == 0
        && incoming().bestBabiesEliminatedCount == 0
        && incoming().bestPlayerName == ''
        && incoming().playCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(levelId)
        && isValidCommunityLevel(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'description',
              'biome',
              'customWallColor',
              'customFloorColor',
              'difficulty',
              'objectiveMode',
              'targetDurationSec',
              'targetKills',
              'criticalLimit',
              'ratSpeed',
              'breedCooldown',
              'layout',
              'tunnels',
              'initialRats',
              'isPublished',
              'updatedAt'
            ])
          )
          || (
            existing().isPublished == true
            && incoming().isPublished == true
            && incoming().playCount == existing().playCount + 1
            && (
              (
                incoming().bestTimeMs == existing().bestTimeMs
                && ('bestScore' in existing() ? incoming().bestScore == existing().bestScore : incoming().bestScore == 0)
                && ('bestEliminatedCount' in existing() ? incoming().bestEliminatedCount == existing().bestEliminatedCount : incoming().bestEliminatedCount == 0)
                && ('bestBabiesEliminatedCount' in existing() ? incoming().bestBabiesEliminatedCount == existing().bestBabiesEliminatedCount : incoming().bestBabiesEliminatedCount == 0)
                && incoming().bestPlayerName == existing().bestPlayerName
              )
              || (
                (
                  (('objectiveMode' in existing()) && existing().objectiveMode == 'survival')
                    ? (
                        (
                          !('bestEliminatedCount' in existing())
                          || existing().bestEliminatedCount == 0
                          || incoming().bestEliminatedCount > existing().bestEliminatedCount
                          || (incoming().bestEliminatedCount == existing().bestEliminatedCount && (!('bestBabiesEliminatedCount' in existing()) || incoming().bestBabiesEliminatedCount > existing().bestBabiesEliminatedCount || incoming().bestScore > existing().bestScore))
                        )
                        && incoming().bestTimeMs >= 1000
                      )
                    : (
                        (
                          existing().bestTimeMs == 0
                          || incoming().bestTimeMs < existing().bestTimeMs
                          || (
                            incoming().bestTimeMs - existing().bestTimeMs < 100
                            && existing().bestTimeMs - incoming().bestTimeMs < 100
                            && (
                              !('bestEliminatedCount' in existing())
                              || incoming().bestEliminatedCount < existing().bestEliminatedCount
                              || (!('bestBabiesEliminatedCount' in existing()) || incoming().bestBabiesEliminatedCount > existing().bestBabiesEliminatedCount)
                            )
                          )
                        )
                        && incoming().bestTimeMs >= 1000
                      )
                )
                && incoming().bestPlayerName.size() >= 1
              )
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'playCount',
              'bestTimeMs',
              'bestScore',
              'bestEliminatedCount',
              'bestBabiesEliminatedCount',
              'bestPlayerName',
              'updatedAt'
            ])
            && existsAfter(/databases/$(database)/documents/community_levels/$(levelId)/runs/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/community_levels/$(levelId)/runs/$(request.auth.uid)).data.runnerId == request.auth.uid
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(levelId)
        && existing().authorId == request.auth.uid;

      match /runs/{runnerId} {
        allow get: if isValidId(levelId)
          && isValidId(runnerId)
          && (resource == null || existing().isPublic == true);

        allow list: if existing().isPublic == true;

        allow create: if isVerifiedUser()
          && isValidId(levelId)
          && isValidId(runnerId)
          && runnerId == request.auth.uid
          && isValidLevelRun(incoming())
          && hasExactRunKeys(incoming())
          && incoming().levelId == levelId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/community_levels/$(levelId))
          && get(/databases/$(database)/documents/community_levels/$(levelId)).data.isPublished == true;

        allow update: if isVerifiedUser()
          && isValidId(levelId)
          && isValidId(runnerId)
          && runnerId == request.auth.uid
          && existing().runnerId == request.auth.uid
          && isValidLevelRun(incoming())
          && incoming().levelId == existing().levelId
          && incoming().runnerId == existing().runnerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            !('score' in existing())
            || !('babiesEliminatedCount' in existing())
            || incoming().timeMs <= existing().timeMs
            || incoming().score >= existing().score
            || incoming().eliminatedCount >= existing().eliminatedCount
            || incoming().babiesEliminatedCount >= existing().babiesEliminatedCount
          )
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'playerName',
            'timeMs',
            'score',
            'eliminatedCount',
            'babiesEliminatedCount',
            'bornCount',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/community_levels/$(levelId))
          && get(/databases/$(database)/documents/community_levels/$(levelId)).data.isPublished == true;

        allow delete: if isVerifiedUser()
          && isValidId(levelId)
          && isValidId(runnerId)
          && existing().runnerId == request.auth.uid;
      }
    }

    match /story_levels/{summaryId} {
      allow get: if isValidStorySummaryId(summaryId) && (resource == null || existing().isPublic == true);

      allow list: if existing().isPublic == true;

      allow create: if isVerifiedUser()
        && isValidStorySummaryId(summaryId)
        && isValidStorySummary(incoming())
        && hasExactStorySummaryKeys(incoming())
        && string(incoming().levelId) + '_' + incoming().difficulty == summaryId
        && incoming().playCount == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/story_levels/$(summaryId)/runs/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/story_levels/$(summaryId)/runs/$(request.auth.uid)).data.runnerId == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidStorySummaryId(summaryId)
        && isValidStorySummary(incoming())
        && incoming().levelId == existing().levelId
        && incoming().difficulty == existing().difficulty
        && incoming().isPublic == existing().isPublic
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().playCount == existing().playCount + 1
        && (
          (
            incoming().bestTimeMs == existing().bestTimeMs
            && incoming().bestScore == existing().bestScore
            && incoming().bestEliminatedCount == existing().bestEliminatedCount
            && incoming().bestBabiesEliminatedCount == existing().bestBabiesEliminatedCount
            && incoming().bestPlayerName == existing().bestPlayerName
          )
          || (
            (
              incoming().bestTimeMs < existing().bestTimeMs
              || incoming().bestScore > existing().bestScore
              || incoming().bestEliminatedCount > existing().bestEliminatedCount
              || (
                incoming().bestTimeMs - existing().bestTimeMs < 100
                && existing().bestTimeMs - incoming().bestTimeMs < 100
                && (
                  incoming().bestEliminatedCount < existing().bestEliminatedCount
                  || incoming().bestBabiesEliminatedCount > existing().bestBabiesEliminatedCount
                )
              )
            )
            && incoming().bestPlayerName.size() >= 1
          )
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'playCount',
          'bestTimeMs',
          'bestScore',
          'bestEliminatedCount',
          'bestBabiesEliminatedCount',
          'bestPlayerName',
          'updatedAt'
        ])
        && existsAfter(/databases/$(database)/documents/story_levels/$(summaryId)/runs/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/story_levels/$(summaryId)/runs/$(request.auth.uid)).data.runnerId == request.auth.uid;

      allow delete: if false;

      match /runs/{runnerId} {
        allow get: if isValidStorySummaryId(summaryId)
          && isValidId(runnerId)
          && (resource == null || existing().isPublic == true);

        allow list: if existing().isPublic == true;

        allow create: if isVerifiedUser()
          && isValidStorySummaryId(summaryId)
          && isValidId(runnerId)
          && runnerId == request.auth.uid
          && isValidStoryRun(incoming())
          && hasExactStoryRunKeys(incoming())
          && string(incoming().levelId) + '_' + incoming().difficulty == summaryId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/story_levels/$(summaryId));

        allow update: if isVerifiedUser()
          && isValidStorySummaryId(summaryId)
          && isValidId(runnerId)
          && runnerId == request.auth.uid
          && existing().runnerId == request.auth.uid
          && isValidStoryRun(incoming())
          && incoming().levelId == existing().levelId
          && incoming().runnerId == existing().runnerId
          && incoming().difficulty == existing().difficulty
          && incoming().objectiveMode == existing().objectiveMode
          && incoming().isPublic == existing().isPublic
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().timeMs <= existing().timeMs
            || incoming().score >= existing().score
            || incoming().eliminatedCount >= existing().eliminatedCount
            || incoming().babiesEliminatedCount >= existing().babiesEliminatedCount
          )
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'playerName',
            'difficulty',
            'timeMs',
            'score',
            'eliminatedCount',
            'babiesEliminatedCount',
            'bornCount',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/story_levels/$(summaryId));

        allow delete: if isVerifiedUser()
          && isValidStorySummaryId(summaryId)
          && isValidId(runnerId)
          && existing().runnerId == request.auth.uid;
      }
    }
  }
}
